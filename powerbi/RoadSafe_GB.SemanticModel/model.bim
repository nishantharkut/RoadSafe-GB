{
  "name": "RoadSafe_GB_Model",
  "compatibilityLevel": 1606,
  "model": {
    "culture": "en-GB",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-GB",
    "tables": [
      {
        "name": "fact_collisions",
        "columns": [
          {
            "name": "collision_index",
            "dataType": "string",
            "sourceColumn": "collision_index",
            "summarizeBy": "none"
          },
          {
            "name": "collision_year",
            "dataType": "int64",
            "sourceColumn": "collision_year",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "date",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy"
          },
          {
            "name": "time",
            "dataType": "string",
            "sourceColumn": "time",
            "summarizeBy": "none"
          },
          {
            "name": "hour",
            "dataType": "int64",
            "sourceColumn": "hour",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "day_of_week",
            "dataType": "int64",
            "sourceColumn": "day_of_week",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "day_of_week_name",
            "dataType": "string",
            "sourceColumn": "day_of_week_name",
            "summarizeBy": "none",
            "sortByColumn": "day_of_week"
          },
          {
            "name": "month",
            "dataType": "int64",
            "sourceColumn": "month",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "month_name",
            "dataType": "string",
            "sourceColumn": "month_name",
            "summarizeBy": "none",
            "sortByColumn": "month"
          },
          {
            "name": "severity",
            "dataType": "string",
            "sourceColumn": "severity",
            "summarizeBy": "none"
          },
          {
            "name": "collision_severity",
            "dataType": "int64",
            "sourceColumn": "collision_severity",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "is_fatal_or_serious",
            "dataType": "int64",
            "sourceColumn": "is_fatal_or_serious",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "number_of_vehicles",
            "dataType": "int64",
            "sourceColumn": "number_of_vehicles",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "number_of_casualties",
            "dataType": "int64",
            "sourceColumn": "number_of_casualties",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "speed_limit",
            "dataType": "int64",
            "sourceColumn": "speed_limit",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "weather_conditions",
            "dataType": "string",
            "sourceColumn": "weather_conditions",
            "summarizeBy": "none"
          },
          {
            "name": "light_conditions",
            "dataType": "string",
            "sourceColumn": "light_conditions",
            "summarizeBy": "none"
          },
          {
            "name": "road_surface_conditions",
            "dataType": "string",
            "sourceColumn": "road_surface_conditions",
            "summarizeBy": "none"
          },
          {
            "name": "road_type",
            "dataType": "string",
            "sourceColumn": "road_type",
            "summarizeBy": "none"
          },
          {
            "name": "urban_rural",
            "dataType": "string",
            "sourceColumn": "urban_rural",
            "summarizeBy": "none"
          },
          {
            "name": "latitude",
            "dataType": "double",
            "sourceColumn": "latitude",
            "summarizeBy": "none"
          },
          {
            "name": "longitude",
            "dataType": "double",
            "sourceColumn": "longitude",
            "summarizeBy": "none"
          },
          {
            "name": "grid_cell",
            "dataType": "string",
            "sourceColumn": "grid_cell",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "month_short",
            "dataType": "string",
            "expression": "LEFT(fact_collisions[month_name], 3)",
            "sortByColumn": "month"
          }
        ],
        "partitions": [
          {
            "name": "fact_collisions",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    RawCsv = Csv.Document(File.Contents(\"C:/N Drive/Github projects/bdm-project/powerbi/exports/fact_collisions.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(RawCsv, [PromoteAllScalars=true]),",
                "    Nulls = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(Nulls, {{\"collision_index\", type text}, {\"collision_year\", Int64.Type}, {\"date\", type date}, {\"time\", type text}, {\"hour\", Int64.Type}, {\"day_of_week\", Int64.Type}, {\"day_of_week_name\", type text}, {\"month\", Int64.Type}, {\"month_name\", type text}, {\"severity\", type text}, {\"collision_severity\", Int64.Type}, {\"is_fatal_or_serious\", Int64.Type}, {\"number_of_vehicles\", Int64.Type}, {\"number_of_casualties\", Int64.Type}, {\"speed_limit\", Int64.Type}, {\"weather_conditions\", type text}, {\"light_conditions\", type text}, {\"road_surface_conditions\", type text}, {\"road_type\", type text}, {\"urban_rural\", type text}, {\"latitude\", type number}, {\"longitude\", type number}, {\"grid_cell\", type text}}, \"en-GB\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Collisions",
            "expression": "COALESCE(COUNTROWS(fact_collisions), 0)",
            "formatString": "#,0",
            "displayFolder": "Collision measures"
          },
          {
            "name": "Total Casualties",
            "expression": "SUM(fact_collisions[number_of_casualties])",
            "formatString": "#,0",
            "displayFolder": "Collision measures"
          },
          {
            "name": "Total Vehicles",
            "expression": "SUM(fact_collisions[number_of_vehicles])",
            "formatString": "#,0",
            "displayFolder": "Collision measures"
          },
          {
            "name": "Fatal Collisions",
            "expression": "CALCULATE([Total Collisions], KEEPFILTERS(fact_collisions[severity] = \"Fatal\"))",
            "formatString": "#,0",
            "displayFolder": "Collision measures"
          },
          {
            "name": "Serious Collisions",
            "expression": "CALCULATE([Total Collisions], KEEPFILTERS(fact_collisions[severity] = \"Serious\"))",
            "formatString": "#,0",
            "displayFolder": "Collision measures"
          },
          {
            "name": "Slight Collisions",
            "expression": "CALCULATE([Total Collisions], KEEPFILTERS(fact_collisions[severity] = \"Slight\"))",
            "formatString": "#,0",
            "displayFolder": "Collision measures"
          },
          {
            "name": "Severe Collisions",
            "expression": "[Fatal Collisions] + [Serious Collisions]",
            "formatString": "#,0",
            "displayFolder": "Collision measures"
          },
          {
            "name": "Severe Share",
            "expression": "DIVIDE([Severe Collisions], [Total Collisions])",
            "formatString": "0.00%",
            "displayFolder": "Collision measures"
          },
          {
            "name": "Casualties per Collision",
            "expression": "DIVIDE([Total Casualties], [Total Collisions])",
            "formatString": "0.00",
            "displayFolder": "Collision measures"
          },
          {
            "name": "Rural Collisions",
            "expression": "CALCULATE([Total Collisions], fact_collisions[urban_rural] = \"Rural\")",
            "formatString": "#,0",
            "displayFolder": "Collision measures"
          },
          {
            "name": "Rural Severe Share",
            "expression": "CALCULATE([Severe Share], fact_collisions[urban_rural] = \"Rural\")",
            "formatString": "0.00%",
            "displayFolder": "Collision measures"
          },
          {
            "name": "Weekend Severe Share",
            "expression": "CALCULATE([Severe Share], dim_calendar[is_weekend] = 1)",
            "formatString": "0.00%",
            "displayFolder": "Collision measures"
          },
          {
            "name": "Weekday Severe Share",
            "expression": "CALCULATE([Severe Share], dim_calendar[is_weekend] = 0)",
            "formatString": "0.00%",
            "displayFolder": "Collision measures"
          },
          {
            "name": "Weekend Difference pp",
            "expression": "VAR WeekendShare = [Weekend Severe Share] VAR WeekdayShare = [Weekday Severe Share] RETURN IF(NOT ISBLANK(WeekendShare) && NOT ISBLANK(WeekdayShare), (WeekendShare - WeekdayShare) * 100)",
            "formatString": "0.00\" pp\"",
            "displayFolder": "Collision measures"
          },
          {
            "name": "Active Grid Cells",
            "expression": "CALCULATE(DISTINCTCOUNT(fact_collisions[grid_cell]), fact_collisions[grid_cell] <> BLANK())",
            "formatString": "#,0",
            "displayFolder": "Collision measures"
          }
        ]
      },
      {
