            "sourceColumn": "longitude",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "agg_hotspots_grid",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    RawCsv = Csv.Document(File.Contents(\"C:/N Drive/Github projects/bdm-project/powerbi/exports/agg_hotspots_grid.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(RawCsv, [PromoteAllScalars=true]),",
                "    Nulls = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(Nulls, {{\"grid_id\", type text}, {\"collision_year\", Int64.Type}, {\"total_collisions\", Int64.Type}, {\"fatal_count\", Int64.Type}, {\"serious_count\", Int64.Type}, {\"slight_count\", Int64.Type}, {\"serious_fatal_share_pct\", type number}, {\"total_casualties\", Int64.Type}, {\"latitude\", type number}, {\"longitude\", type number}}, \"en-GB\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Grid Collisions",
            "expression": "CALCULATE(SUM(agg_hotspots_grid[total_collisions]), TREATAS(VALUES(dim_calendar[year]), agg_hotspots_grid[collision_year]))",
            "formatString": "#,0"
          },
          {
            "name": "Grid Severe Share",
            "expression": "DIVIDE(CALCULATE(SUM(agg_hotspots_grid[fatal_count]) + SUM(agg_hotspots_grid[serious_count]), TREATAS(VALUES(dim_calendar[year]), agg_hotspots_grid[collision_year])), [Grid Collisions])",
            "formatString": "0.00%"
          },
          {
            "name": "Grid Longitude",
            "expression": "CALCULATE(AVERAGE(agg_hotspots_grid[longitude]), TREATAS(VALUES(dim_calendar[year]), agg_hotspots_grid[collision_year]))",
            "formatString": "0.00"
          },
          {
            "name": "Grid Latitude",
            "expression": "CALCULATE(AVERAGE(agg_hotspots_grid[latitude]), TREATAS(VALUES(dim_calendar[year]), agg_hotspots_grid[collision_year]))",
            "formatString": "0.00"
          }
        ]
      },
