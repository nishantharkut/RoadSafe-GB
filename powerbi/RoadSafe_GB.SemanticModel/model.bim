          },
          {
            "name": "quarter",
            "dataType": "string",
            "sourceColumn": "quarter",
            "summarizeBy": "none"
          },
          {
            "name": "year_month",
            "dataType": "string",
            "sourceColumn": "year_month",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_calendar",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    RawCsv = Csv.Document(File.Contents(\"C:/N Drive/Github projects/bdm-project/powerbi/exports/dim_calendar.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(RawCsv, [PromoteAllScalars=true]),",
                "    Nulls = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(Nulls, {{\"date\", type date}, {\"year\", Int64.Type}, {\"month_number\", Int64.Type}, {\"month_name\", type text}, {\"day_of_month\", Int64.Type}, {\"day_of_week\", Int64.Type}, {\"weekday_name\", type text}, {\"is_weekend\", Int64.Type}, {\"quarter\", type text}, {\"year_month\", type text}}, \"en-GB\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "agg_hotspots_grid",
        "columns": [
